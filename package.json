{
  "name": "aria-burn-core",
  "version": "0.1.0",
  "description": "TypeScript simulation core for the Aria Burn material burn model",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26 <27"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./contract/schema/*": "./src/contract/schema/*",
    "./contract/fixtures/*": "./src/contract/fixtures/*",
    "./profiles/provisional/*": "./src/profiles/provisional/*",
    "./profiles/catalog/*": "./src/profiles/catalog/*",
    "./calibration": "./src/calibration/index.ts",
    "./svg": "./src/svg/index.ts",
    "./svg/fixtures/*": "./src/svg/fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "contract:export": "tsx scripts/export-contract.ts",
    "bench": "vite bench --port 5199 --strictPort",
    "wt:start": "node scripts/worktree.mjs start",
    "wt:finish": "node scripts/worktree.mjs finish",
    "wt:list": "node scripts/worktree.mjs list",
    "mainline": "node scripts/worktree.mjs mainline",
    "wrap": "node scripts/worktree.mjs wrap",
    "golden:update": "node scripts/golden-update.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/pngjs": "^6",
    "ajv": "^8",
    "ajv-formats": "^3",
    "pngjs": "^7",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3"
  }
}
